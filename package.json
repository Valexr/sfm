{
  "name": "sfm",
  "description": "SomaFM svelteJS player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild",
    "dev": "node esbuild --dev --spa",
    "preview": "npx esbuild --servedir=public",
    "lint": "eslint ./src && prettier --check ./src",
    "format": "prettier --write ./src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Valexr/sfm.git"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/svelte": "^5.0.8",
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.55.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
