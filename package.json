{
  "name": "sfm",
  "description": "SomaFM svelteJS player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild",
    "dev": "node esbuild --dev --spa",
    "preview": "npx esbuild --servedir=public",
    "lint": "biome check --fix --max-diagnostics=100",
    "format": "biome format --write --max-diagnostics=100"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Valexr/sfm.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tsconfig/svelte": "^5.0.8",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "globals": "^17.7.0",
    "svelte": "^5.56.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
